# Safe disposable Compose settings for host-run components. No real secrets.
# Compose itself is fixed configuration and does not read this file.
GRID_ENV_ID=local-dev
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC_PREFIX=local-dev.
# Example only: each component selects its own group (see infra/compose/README.md).
KAFKA_CONSUMER_GROUP=local-dev.projection.events.v1
REGISTRY_DATABASE_URL=postgresql://registry:registry_disposable@127.0.0.1:15432/local_dev_registry
CONTROL_DATABASE_URL=postgresql://control:control_disposable@127.0.0.1:15432/local_dev_control
PROJECTION_DATABASE_URL=postgresql://projection:projection_disposable@127.0.0.1:15432/local_dev_projection
COPILOT_AUDIT_DATABASE_URL=postgresql://copilot_audit:copilot_audit_disposable@127.0.0.1:15432/local_dev_copilot_audit
TOXIPROXY_URL=http://127.0.0.1:18474
# For a PostgreSQL fault test replace the owning component's DB port with 15433.
MODEL_PROVIDER=MOCK
